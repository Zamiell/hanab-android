# Keep line endings stable across machines
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Never touch binaries
*.jar binary
*.mp3 binary
*.png binary

# Generated from the website's protocol (scripts/protocol.ps1 gen): collapsed in diffs and left out of language stats
app/src/main/java/live/hanab/client/protocol/Protocol.kt linguist-generated=true
app/src/test/resources/protocol/compatibility.json linguist-generated=true
*.sh text eol=lf
